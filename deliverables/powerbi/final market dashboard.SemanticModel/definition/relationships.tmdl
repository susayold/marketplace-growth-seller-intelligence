relationship rel-dim-month-fact
	fromColumn: bi_fact_marketplace_item.month_start
	toColumn: DimMonth.MonthStart

relationship rel-dim-category-fact
	fromColumn: bi_fact_marketplace_item.product_category
	toColumn: DimCategory.product_category

