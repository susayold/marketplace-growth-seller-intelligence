table CustomerExperience
	lineageTag: 42aad6f1-c9c8-4fa6-bed4-68ff0ccf0385

	measure 'CX Late Delivery Rate' = MAX ( CustomerExperience[SummaryLateRate] )
		formatString: 0.0%
		lineageTag: f74371fe-9b1c-4023-ad18-dce56d98cf70

	measure 'CX Average Review' = MAX ( CustomerExperience[SummaryAvgReview] )
		formatString: 0.00
		lineageTag: 21249b42-53d3-47bd-ada0-df9205ed918a

	measure 'CX Low Review Rate' = MAX ( CustomerExperience[SummaryLowReviewRate] )
		formatString: 0.0%
		lineageTag: 6e5d52d4-c913-43d1-8928-8c9e82aefc5b

	measure 'CX Review Gap' = VAR OnTimeReview = CALCULATE ( MAX ( CustomerExperience[AvgReview] ), CustomerExperience[Segment] = "On Time" ) VAR LateReview = CALCULATE ( MAX ( CustomerExperience[AvgReview] ), CustomerExperience[Segment] = "Late" ) RETURN OnTimeReview - LateReview
		formatString: 0.00
		lineageTag: 1ff7b6c1-1704-4d0b-8894-0f788726eb6d

	measure 'CX Late Delivery Delay Days' = CALCULATE ( MAX ( CustomerExperience[AverageScheduleGapDays] ), CustomerExperience[Segment] = "Late" )
		formatString: 0.0
		lineageTag: 3cfb2673-295d-4112-b5c1-b05f5e2d5536

	measure 'CX Late Rate Delta Label' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR Delta = ( MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[late_delivery_rate] ) - MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[late_delivery_rate] ) ) * 100 RETURN IF ( Delta <= 0, "▼ ", "▲ " ) & FORMAT ( Delta, "+0.0;-0.0;0.0" ) & " pp vs prior month"
		formatString: General
		lineageTag: 5f1a0e21-36f0-4d1f-9b08-1d0ad2b4f301

	measure 'CX Review Delta Label' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR Delta = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[avg_review_score] ) - MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[avg_review_score] ) RETURN IF ( Delta >= 0, "▲ ", "▼ " ) & FORMAT ( Delta, "+0.00;-0.00;0.00" ) & " vs prior month"
		formatString: General
		lineageTag: 6a2b1f32-47f1-4e20-ac19-2e1be3c5f402

	measure 'CX Low Review Delta Label' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR Delta = ( MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[low_review_rate] ) - MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[low_review_rate] ) ) * 100 RETURN IF ( Delta <= 0, "▼ ", "▲ " ) & FORMAT ( Delta, "+0.0;-0.0;0.0" ) & " pp vs prior month"
		formatString: General
		lineageTag: 7b3c2043-58a2-4f31-bd2a-3f2cf4d60503

	measure 'CX Review Gap Delta Label' = "• Late reviews are " & FORMAT ( [CX Review Gap], "0.00" ) & " points lower"
		formatString: General
		lineageTag: 8c4d3154-69b3-4042-ce3b-4a3da5e71604

	measure 'CX Late Delay Delta Label' = "• Late orders average " & FORMAT ( [CX Late Delivery Delay Days], "0.0" ) & " days late"
		formatString: General
		lineageTag: 9d5e4265-70c4-4153-df4c-5a4ea6f82705

