table AcquisitionChannel
	lineageTag: 721e375e-fb53-4caf-a23e-68206510c806

	measure 'Total MQLs' = SUM ( AcquisitionChannel[mqls] )
		formatString: #,0
		lineageTag: b56383cf-96d3-4d2e-8759-01a9c389e3d3

	measure 'Total Converted Sellers' = SUM ( AcquisitionChannel[converted_sellers] )
		formatString: #,0
		lineageTag: e045867d-aa49-4bb2-b8d0-2ec229017529

	measure 'Total Matched Sellers' = SUM ( AcquisitionChannel[matched_sellers] )
		formatString: #,0
		lineageTag: 6b0565b3-da04-4ea3-b8be-7d3c4a558419

	measure 'Overall Conversion Rate' = DIVIDE ( [Total Converted Sellers], [Total MQLs] )
		formatString: 0.0%
		lineageTag: 9df78d2a-6034-475a-996c-45b9d6c84aed

	measure 'Total Downstream GMV Proxy' = SUM ( AcquisitionChannel[downstream_gmv_proxy] )
		formatString: R$ #,##0.00
		lineageTag: aaae6aa5-4f4b-4c93-b134-cfaaeb2fdf14

	measure 'Total Downstream Orders' = SUM ( AcquisitionChannel[downstream_orders] )
		formatString: #,##0.0
		lineageTag: c6b8c7b7-7b72-43f4-b5f0-2e6f0bfa8e11

	measure 'Total GMV per Matched Seller' = DIVIDE ( [Total Downstream GMV Proxy], [Total Matched Sellers] )
		formatString: R$ #,##0.00
		lineageTag: 49a94eb6-6fe4-48df-8ac4-1c0f2af9c9a1

	measure 'Acq MQL Delta Label' = VAR CurrentValue = [Total MQLs] VAR Largest = MAX ( AcquisitionChannel[mqls] ) RETURN "▲ " & FORMAT ( DIVIDE ( Largest, CurrentValue ), "0.0%" ) & " top-channel share"
		formatString: General
		lineageTag: 80a2b0c1-d2e3-4f50-a6b7-c8d9e0f10201

	measure 'Acq Converted Delta Label' = VAR CurrentValue = [Total Converted Sellers] VAR Largest = MAX ( AcquisitionChannel[converted_sellers] ) RETURN "▲ " & FORMAT ( DIVIDE ( Largest, CurrentValue ), "0.0%" ) & " top-channel share"
		formatString: General
		lineageTag: 80a2b0c1-d2e3-4f50-a6b7-c8d9e0f10202

	measure 'Acq Matched Delta Label' = VAR CurrentValue = [Total Matched Sellers] VAR Largest = MAX ( AcquisitionChannel[matched_sellers] ) RETURN "▲ " & FORMAT ( DIVIDE ( Largest, CurrentValue ), "0.0%" ) & " top-channel share"
		formatString: General
		lineageTag: 80a2b0c1-d2e3-4f50-a6b7-c8d9e0f10203

	measure 'Acq Conversion Delta Label' = VAR Benchmark = MEDIANX ( ALL ( AcquisitionChannel[Channel] ), CALCULATE ( AVERAGE ( AcquisitionChannel[conversion_rate] ) ) ) VAR Delta = [Overall Conversion Rate] - Benchmark RETURN IF ( Delta >= 0, "▲ ", "▼ " ) & FORMAT ( Delta * 100, "+0.0;-0.0;0.0" ) & " pp vs median"
		formatString: General
		lineageTag: 80a2b0c1-d2e3-4f50-a6b7-c8d9e0f10204

	measure 'Acq GMV Per Seller Delta Label' = VAR Benchmark = MEDIANX ( ALL ( AcquisitionChannel[Channel] ), CALCULATE ( AVERAGE ( AcquisitionChannel[gmv_per_matched_seller] ) ) ) VAR Delta = DIVIDE ( [Total GMV per Matched Seller] - Benchmark, Benchmark ) RETURN IF ( Delta >= 0, "▲ ", "▼ " ) & FORMAT ( Delta, "+0.0%;-0.0%;0.0%" ) & " vs median"
		formatString: General
		lineageTag: 80a2b0c1-d2e3-4f50-a6b7-c8d9e0f10205

