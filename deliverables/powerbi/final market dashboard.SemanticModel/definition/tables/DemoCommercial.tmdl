table DemoCommercial
	lineageTag: 69c06a94-e36b-44fb-a4df-61bf01e5b0da

	measure 'Commercial GMV' = SUM ( DemoCommercial[GMV_M] )
		formatString: 0.00
		lineageTag: 00c0bdca-3793-4332-9fae-7c930989de6a

	measure 'Commercial Orders' = SUM ( DemoCommercial[Orders_K] )
		formatString: 0.0
		lineageTag: 7a59739a-9764-4b00-99e5-5b3084e62a25

	measure 'Commercial AOV' = DIVIDE ( SUMX ( DemoCommercial, DemoCommercial[GMV_M] * 1000000 ), SUMX ( DemoCommercial, DemoCommercial[Orders_K] * 1000 ) )
		formatString: R$ #,0.0
		lineageTag: 492b359c-fc11-4013-8072-c8e61f48df67

	measure 'Commercial Top Segment Share' = MAX ( DemoCommercial[ShareGMV] )
		formatString: 0.0%
		lineageTag: 9257d64e-9655-4273-b910-0f3c65172eb2

	measure 'Commercial Concentration Signal' = "Top segment contributes " & FORMAT ( [Commercial Top Segment Share], "0.0%" )
		formatString: General
		lineageTag: 32dae51f-dec5-4cd9-acb9-0ab5835434b7

	measure 'Commercial GMV Delta Label' = VAR D = [GMV Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & " vs prior month" )
		formatString: General
		lineageTag: 5f1a0e21-36f0-4d1f-9b08-1d0ad2b4f201

	measure 'Commercial Orders Delta Label' = VAR D = [Orders Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & " vs prior month" )
		formatString: General
		lineageTag: 6a2b1f32-47f1-4e20-ac19-2e1be3c5f302

	measure 'Commercial AOV Delta Label' = VAR D = [AOV Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & " vs prior month" )
		formatString: General
		lineageTag: 7b3c2043-58a2-4f31-bd2a-3f2cf4d60303

	measure 'Commercial Top Share Delta Label' = "• " & FORMAT ( [Commercial Top Segment Share], "0.0%" ) & " of total GMV"
		formatString: General
		lineageTag: 8c4d3154-69b3-4042-ce3b-4a3da5e71404

	measure 'Commercial Concentration Delta Label' = VAR TopShare = [Commercial Top Segment Share] VAR NextShare = MAXX ( FILTER ( DemoCommercial, DemoCommercial[ShareGMV] < TopShare ), DemoCommercial[ShareGMV] ) RETURN "▲ +" & FORMAT ( ( TopShare - NextShare ) * 100, "0.0" ) & " pp vs next segment"
		formatString: General
		lineageTag: 9d5e4265-70c4-4153-df4c-5a4ea6f82505

