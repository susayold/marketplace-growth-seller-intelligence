		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0509

	measure 'GMV Proxy' = MAX ( Snapshot[GMV] )
		formatString: R$ #,0.00
		lineageTag: 83ace3f0-059f-53b3-8bc6-522f2944a707

	measure Orders = SUM ( Monthly[orders] )
		formatString: #,0
		lineageTag: b0030367-6b10-5b22-ace8-ddee0f2bbc45

	measure 'Active Sellers' = DISTINCTCOUNT ( SellerLifetime[seller_id] )
		formatString: #,0
		lineageTag: 0713e522-9acf-53f4-a795-7449f97b8632

	measure 'Average Order Value' = DIVIDE ( [GMV Proxy], [Orders] )
		formatString: R$ #,0.00
		lineageTag: 78a2d082-77d7-52c2-be44-0f9fb2787682

	measure 'Delivered Orders' = SUM ( Monthly[delivered_orders] )
		formatString: #,0
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0301

	measure 'Late Orders' = SUM ( Monthly[late_orders] )
		formatString: #,0
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0302

	measure 'Late Delivery Rate' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%
		lineageTag: b9a46605-b6d2-52b8-b5c1-02cd4a01fafd

	measure 'GMV Proxy Display' = "R$ " & FORMAT ( DIVIDE ( [GMV Proxy], 1000000 ), "0.00" ) & "M"
		lineageTag: f903bfae-da14-5765-a232-6175629ae664

	measure 'Orders Display' = FORMAT ( DIVIDE ( [Orders], 1000 ), "0.0" ) & "K"
		lineageTag: f6e3d2b6-89fd-584b-a0db-a3f38369f0cc

	measure 'Active Sellers Display' = FORMAT ( [Active Sellers], "#,0" )
		lineageTag: e83e4452-b26e-5662-97cb-1cb3ef8f8c7e

	measure 'Average Order Value Display' = "R$ " & FORMAT ( [Average Order Value], "0.00" )
		lineageTag: 2be71e55-0715-5fa5-92dd-ac4d2c0aab5a

	measure 'Late Delivery Rate Display' = FORMAT ( [Late Delivery Rate], "0.0%" )
		lineageTag: bcc086e2-41cb-52d7-b800-4ae0ccaa8294

	measure 'GMV Proxy (R$M)' = DIVIDE ( [GMV Proxy], 1000000 )
		formatString: 0.00
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0601

	measure 'Orders (K)' = DIVIDE ( [Orders], 1000 )
		formatString: 0.0
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0602

	measure 'Trend GMV Proxy (R$M)' = IF ( ISBLANK ( SELECTEDVALUE ( DimMonth[MonthStart] ) ), BLANK (), [Legacy Monthly GMV Trend RSM] )
		formatString: 0.00
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0603

	measure 'Trend Orders (K)' = IF ( ISBLANK ( SELECTEDVALUE ( DimMonth[MonthStart] ) ), BLANK (), [Legacy Monthly Orders Trend K] )
		formatString: 0.0
		lineageTag: 8d49c4a8-9a25-4f6f-9d4e-1e5c7f8a0604

	measure 'Seller Gini' = MAXX ( FILTER ( ConcentrationStats, ConcentrationStats[metric] = "gini" ), ConcentrationStats[value] )
		formatString: 0.000
		lineageTag: 8c276ac2-1087-5e81-af49-a222d0b9668d

	measure 'Top 20% GMV' = MAXX ( FILTER ( ConcentrationStats, ConcentrationStats[metric] = "top_20_pct_share" ), ConcentrationStats[value] )
		formatString: 0.0%
		lineageTag: 65d5df53-98b1-51e3-ac47-f57dd27fcf6e

	measure 'GMV Delta' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR LatestValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[gmv_proxy] ) VAR PriorValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[gmv_proxy] ) RETURN DIVIDE ( LatestValue - PriorValue, PriorValue )
		formatString: 0.0%;-0.0%;-
		lineageTag: b4abf16c-b266-5d71-b6a1-40c155f2426f

	measure 'Orders Delta' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR LatestValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[orders] ) VAR PriorValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[orders] ) RETURN DIVIDE ( LatestValue - PriorValue, PriorValue )
		formatString: 0.0%;-0.0%;-
		lineageTag: b8db8c70-e9eb-579e-af1e-b635477fcfc4

	measure 'Active Sellers Delta' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR LatestValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[active_sellers] ) VAR PriorValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[active_sellers] ) RETURN DIVIDE ( LatestValue - PriorValue, PriorValue )
		formatString: 0.0%;-0.0%;-
		lineageTag: dc353880-aa34-5b2f-aea2-9241a5e16396

	measure 'AOV Delta' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR LatestValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[aov] ) VAR PriorValue = MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[aov] ) RETURN DIVIDE ( LatestValue - PriorValue, PriorValue )
		formatString: 0.0%;-0.0%;-
		lineageTag: bf85b507-33d7-5d83-bd55-3b574ac35d22

	measure 'Late Delivery Delta PP' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR LatestRate = MAXX ( FILTER ( Complete, Monthly[purchase_month] = LatestMonth ), Monthly[late_delivery_rate] ) VAR PriorRate = MAXX ( FILTER ( Complete, Monthly[purchase_month] = PriorMonth ), Monthly[late_delivery_rate] ) RETURN LatestRate - PriorRate
		formatString: 0.0%;-0.0%;-
		lineageTag: bfcd24d0-9856-568d-a912-697e9960dea6

	measure 'GMV Delta Label' = VAR D = [GMV Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & "  vs. previous period" )
		lineageTag: 4ca6b7d7-4a9e-42a1-9a93-7c9e4d6d5d01

	measure 'Orders Delta Label' = VAR D = [Orders Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & "  vs. previous period" )
		lineageTag: 9ba4f31e-0db7-4f7a-b0fd-e2ab40b5c102

	measure 'Active Sellers Delta Label' = VAR D = [Active Sellers Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & "  vs. previous period" )
		lineageTag: 70d54a82-7ebc-4c6d-9ae5-8701bc08e503

	measure 'AOV Delta Label' = VAR D = [AOV Delta] RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D >= 0, "▲ ", "▼ " ) & FORMAT ( D, "+0.0%;-0.0%;0.0%" ) & "  vs. previous period" )
		lineageTag: 97e1cb81-bf4d-4078-bb0c-5da2b59fed04

	measure 'Late Delivery Delta Label' = VAR Complete = FILTER ( ALL ( Monthly ), Monthly[is_executive_complete] = TRUE () ) VAR LatestMonth = MAXX ( Complete, Monthly[purchase_month] ) VAR PriorMonth = MAXX ( FILTER ( Complete, Monthly[purchase_month] < LatestMonth ), Monthly[purchase_month] ) VAR D = [Late Delivery Delta PP] * 100 VAR LatestDate = DATE ( VALUE ( LEFT ( LatestMonth, 4 ) ), VALUE ( RIGHT ( LatestMonth, 2 ) ), 1 ) VAR PriorDate = DATE ( VALUE ( LEFT ( PriorMonth, 4 ) ), VALUE ( RIGHT ( PriorMonth, 2 ) ), 1 ) RETURN IF ( ISBLANK ( D ), BLANK (), IF ( D <= 0, "▼ ", "▲ " ) & FORMAT ( D, "+0.0;-0.0;0.0" ) & " p.p.  vs. " & FORMAT ( PriorDate, "MMM yyyy" ) & " → " & FORMAT ( LatestDate, "MMM yyyy" ) )
		lineageTag: 67a69db4-d7f8-449f-b4c1-f5ed01faa705

	column GMV
		dataType: double
		lineageTag: 87f278e4-73cd-5878-9a8b-3fc354cff1bb
		summarizeBy: sum
		sourceColumn: GMV

	partition Snapshot = m
		mode: import
		source =
				let
					Source = Json.Document(File.Contents(DataRoot & "\\reports\\headline_metrics.json")),
					Output = #table(type table [GMV=number], {{Source[gmv_proxy]}})
				in
					Output

	annotation PBI_ResultType = Table

