	column gmv_proxy
		dataType: double
		formatString: R$ #,0.00
		summarizeBy: sum
		sourceColumn: gmv_proxy
		lineageTag: f01dcdc9-8bd0-5e40-978c-a1c3c8302655

	column orders
		dataType: int64
		formatString: #,0
		summarizeBy: sum
