		sourceColumn: gmv_share
		lineageTag: d7be4973-b010-5ba2-9747-8c9a0c2dfd47

	partition Geo = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("C:\\Users\\sangk\\Documents\\Codex\\2026-09-12\\che\\outputs\\Marketplace_Growth_Seller_Intelligence_Page1\\data\\release_v3_final\\reports\\tables\\mart_geography_performance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"seller_state", type text}, {"gmv_proxy", type number}, {"orders", Int64.Type}, {"active_sellers", Int64.Type}, {"gmv_share", type number}}, "en-US"),
			    Sorted = Table.Sort(Typed, {{"gmv_proxy", Order.Descending}}),
			    Top = Typed
			in
			    Top

	annotation PBI_ResultType = Table

